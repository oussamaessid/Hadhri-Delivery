# The email lets Caddy fall back to ZeroSSL when Let's Encrypt cannot validate (seen on Contabo).
{
 email {$ACME_EMAIL}
}
{$APP_DOMAIN} {
 encode zstd gzip
 header Strict-Transport-Security "max-age=31536000"
 reverse_proxy app:10000
}
www.{$APP_DOMAIN} {
 redir https://{$APP_DOMAIN}{uri} permanent
}
