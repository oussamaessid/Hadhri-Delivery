    "/customer/firebase-config": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Configuration publique Firebase Web",
        "operationId": "get_customer_firebase_config",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {
            "description": "configured et config (null si Firebase n’est pas configuré). Aucun secret serveur."
          },
          "400": {
            "description": "Données invalides"
          },
          "409": {
            "description": "Compte déjà lié à une autre identité"
          }
        }
      }
    },
    "/customer/firebase-session": {
      "post": {
        "tags": [
          "Client"
        ],
        "summary": "Ouvrir une session après validation Firebase",
        "operationId": "post_customer_firebase_session",
        "x-implementation-status": "implemented",
        "description": "Valide le jeton Firebase, exige email_verified=true et lie le UID au client. Cookie HttpOnly limité à la durée du jeton (maximum une heure).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idToken"
                ],
                "properties": {
                  "idToken": {
                    "type": "string",
                    "maxLength": 16000
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ouverte, customer contient id, name, email et phone."
          },
          "400": {
            "description": "Données invalides"
          },
          "409": {
            "description": "Compte déjà lié à une autre identité"
          },
          "401": {
            "description": "Jeton invalide ou expiré"
          },
          "403": {
            "description": "Email non confirmé, fournisseur interdit ou compte suspendu"
          },
          "429": {
            "description": "Trop de tentatives"
          },
          "503": {
            "description": "Firebase non configuré"
          }
        }
      }
    },
