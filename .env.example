# MySQL 8.4 or compatible MariaDB. URL-encode special characters in passwords.
DATABASE_URL=mysql://hadhri:CHANGE_ME@127.0.0.1:3306/hadhri
DATA_DIR=.data/mysql
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ADMIN_PORT=8080

# Firebase web application configuration (Firebase Console > Project settings).
# These four public app identifiers are served to the browser. Never put a service account key here.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Production override only (use real values locally)
APP_DOMAIN=delivery.example.com
BACKUP_ENCRYPTION_KEY=
FIREBASE_ADMIN_CREDENTIALS_FILE=

MYSQL_USER=hadhri
MYSQL_DATABASE=hadhri
MYSQL_PASSWORD=CHANGE_ME
DATABASE_AUTO_CREATE=true

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
DATABASE_SSL=false
DATABASE_SSL_CA=
SEED_DEMO_DATA=false
