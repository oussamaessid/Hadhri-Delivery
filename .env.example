# MySQL/MariaDB server (e.g. XAMPP). Default XAMPP install: user "root", empty password.
DATABASE_URL=mysql://root:@127.0.0.1:3306/hadhri
DATA_DIR=.data/mysql
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ADMIN_PORT=8080

# Firebase web application configuration (Firebase Console > Project settings).
# These four public app identifiers are served to the browser. Never put a service account key here.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Production override only (use real values locally)
APP_DOMAIN=delivery.example.com
BACKUP_ENCRYPTION_KEY=
FIREBASE_ADMIN_CREDENTIALS_FILE=
